{
    "name": "adapik/gmp-polyfill",
    "description": "Pure-PHP polyfill for the GMP extension, backed by brick/math",
    "type": "library",
    "license": "MIT",
    "keywords": ["gmp", "polyfill", "bignum", "arbitrary-precision", "math", "bigint"],
    "authors": [
        {
            "name": "Alexander Danilov",
            "email": "alexfintushal@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "brick/math": "^0.12 || ^0.13 || ^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^1.11 || ^2.0",
        "friendsofphp/php-cs-fixer": "^3.57"
    },
    "autoload": {
        "psr-4": {
            "Adapik\\Polyfill\\Gmp\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Adapik\\Polyfill\\Gmp\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    }
}
